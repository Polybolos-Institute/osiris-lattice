# Copy to .env (never commit .env)
# Host:port with no path. Local mock uses HTTP automatically.
LATTICE_ENDPOINT=127.0.0.1:8765
LATTICE_CLIENT_ID=test-client-id
LATTICE_CLIENT_SECRET=test-client-secret
# Sandboxes Bearer (same as LATTICE_ENV_TOKEN in other Polybolos doors)
LATTICE_ENV_TOKEN=test-sandbox-token
# Optional alias for LATTICE_ENV_TOKEN
# LATTICE_SANDBOX_TOKEN=test-sandbox-token
# Set to 0 to disconnect without deleting credentials
LATTICE_ENABLED=1
